{
  "manifest_version": 3,
  "minimum_chrome_version": "99",
  "name": "航班价格记录簿",
  "version": "1.0.2",
  "description": "在携程国内航班列表页记录机票价格，查看历史最低价与趋势。数据仅存本机，非官方扩展。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://flights.ctrip.com/online/list/*"],
      "js": ["src/content/parser.js", "src/content/autoscroll.js", "src/content/ctrip.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "航班价格记录簿"
  }
}
